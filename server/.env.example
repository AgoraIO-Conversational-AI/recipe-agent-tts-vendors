AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hi! Talk to me and watch the event timeline light up.

# Select the TTS vendor for the agent's speech leg. Default is the keyless,
# Agora-managed `minimax` vendor, so this recipe runs zero-key out of the box.
# Set TTS_VENDOR to any value below and provide that vendor's credentials to swap.
# TTS_VENDOR=minimax
# TTS_VOICE=English_captivating_female1   # optional voice override for the selected vendor
# TTS_MODEL=speech_2_6_turbo              # optional model override for the selected vendor

# --- BYO TTS vendors (set TTS_VENDOR + the listed env vars to use one) ---

# TTS_VENDOR=openai   # keyless (Agora-managed); optional TTS_VOICE override

# TTS_VENDOR=elevenlabs
# ELEVENLABS_API_KEY=your_elevenlabs_api_key

# TTS_VENDOR=cartesia
# CARTESIA_API_KEY is optional — Agora manages the Cartesia key by default.
# CARTESIA_API_KEY=your_cartesia_api_key
# TTS_MODEL=sonic-3.6   # optional managed model override; defaults to sonic-3.6 (BYOK uses sonic-2)

# TTS_VENDOR=deepgram
# DEEPGRAM_API_KEY=your_deepgram_api_key

# TTS_VENDOR=google
# GOOGLE_TTS_API_KEY=your_google_tts_api_key

# TTS_VENDOR=amazon
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1

# TTS_VENDOR=microsoft
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=eastus

# TTS_VENDOR=humeai
# HUME_API_KEY=your_hume_api_key

# TTS_VENDOR=rime
# RIME_API_KEY is optional — Agora manages the Rime key by default.
# RIME_API_KEY=your_rime_api_key

# TTS_VENDOR=fishaudio
# FISH_API_KEY is optional — Agora manages the Fish Audio key by default.
# FISH_REFERENCE_ID is optional in managed mode (defaults to voice
# 59cb5986671546eaa6ca8ae6f29f6d22) and required when FISH_API_KEY is set.
# FISH_API_KEY=your_fish_api_key
# FISH_REFERENCE_ID=your_fish_reference_id
# TTS_MODEL=s2.1-pro   # optional managed backend override; defaults to s2.1-pro (BYOK uses speech-1.6)

# TTS_VENDOR=sarvam
# SARVAM_API_KEY=your_sarvam_api_key
# TTS_MODEL=bulbul:v3   # optional; defaults to bulbul:v3
# TTS_VOICE=ishita      # optional speaker; defaults to ishita (speakers are model-specific)

# TTS_VENDOR=murf
# MURF_API_KEY=your_murf_api_key

# TTS_VENDOR=gradium
# GRADIUM_API_KEY=your_gradium_api_key

# TTS_VENDOR=mistral
# MISTRAL_API_KEY=your_mistral_api_key

# TTS_VENDOR=typecast
# TYPECAST_API_KEY=your_typecast_api_key

# TTS_VENDOR=smallestai
# SMALLEST_API_KEY=your_smallestai_api_key
# TTS_MODEL=lightning_v3.1_pro   # optional; defaults to lightning_v3.1_pro
# TTS_VOICE=kaitlyn             # optional; defaults to kaitlyn
# TTS_LANGUAGE=en   # optional Smallest AI ISO 639-1 language code; defaults to en

# TTS_VENDOR=gemini   # production global vendor
# GEMINI_API_KEY=your_gemini_api_key
# TTS_MODEL=gemini-3.8-flash-tts   # optional; defaults to gemini-3.8-flash-tts
# TTS_VOICE=Puck                   # optional; defaults to Puck
