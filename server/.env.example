AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hi! Talk to me and watch the event timeline light up.

# Select the TTS vendor for the agent's speech leg. Default is the keyless,
# Agora-managed `minimax` vendor, so this recipe runs zero-key out of the box.
# Set TTS_VENDOR to any value below and provide that vendor's credentials to swap.
# TTS_VENDOR=minimax
# TTS_VOICE=English_captivating_female1   # optional voice override for the selected vendor
# TTS_MODEL=speech_2_6_turbo              # optional model override for the selected vendor

# --- BYO TTS vendors (set TTS_VENDOR + the listed env vars to use one) ---

# TTS_VENDOR=openai   # keyless (Agora-managed); optional TTS_VOICE override

# TTS_VENDOR=elevenlabs
# ELEVENLABS_API_KEY=your_elevenlabs_api_key

# TTS_VENDOR=cartesia
# CARTESIA_API_KEY=your_cartesia_api_key

# TTS_VENDOR=deepgram
# DEEPGRAM_API_KEY=your_deepgram_api_key

# TTS_VENDOR=google
# GOOGLE_TTS_API_KEY=your_google_tts_api_key

# TTS_VENDOR=amazon
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1

# TTS_VENDOR=microsoft
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=eastus

# TTS_VENDOR=humeai
# HUME_API_KEY=your_hume_api_key

# TTS_VENDOR=rime
# RIME_API_KEY is optional — Agora manages the Rime key by default.
# RIME_API_KEY=your_rime_api_key

# TTS_VENDOR=fishaudio
# FISH_API_KEY=your_fish_api_key
# FISH_REFERENCE_ID=your_fish_reference_id

# TTS_VENDOR=sarvam
# SARVAM_API_KEY=your_sarvam_api_key

# TTS_VENDOR=murf
# MURF_API_KEY=your_murf_api_key
